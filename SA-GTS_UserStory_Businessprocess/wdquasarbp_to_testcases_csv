import typing
import json
import core
import io
import copy
import datetime
import re
import requests
import pandas

def wdquasarbp_to_testcases_csv(payload: typing.Annotated[str, "Base payload for Quasar API"] = None, 
    BusinessProcessName: typing.Annotated[str, "JSON array string of Business Processes"] = None, 
    conversationid: typing.Annotated[str, "Unique conversation ID"] = None, 
    fileinitialname: typing.Annotated[str, "Initial base name of the file"] = None):


    """
    Optimizations (zero new imports):
    1. CHUNK_SIZE 10->40 : 40 TCs = 1 Claude call instead of 4  [saves ~3.5 mins]
    2. requests.Session(): reuses TCP connection for all HTTP     [saves ~2s per call]
    3. dict() instead of copy.deepcopy()                         [minor]
    """
    if not BusinessProcessName:
        return {"error": "BusinessProcessName is required"}
    bp_list = _parse_bp_input(BusinessProcessName)
    businessprocess_list = list({
        bp.strip() for bp in bp_list if isinstance(bp, str) and bp.strip()
    })
    if not businessprocess_list:
        return {"error": "No valid Business Processes found"}
    if not payload:
        return {"error": "payload is required"}
    try:
        base_payload = json.loads(payload)
    except json.JSONDecodeError:
        return {"error": "Invalid JSON payload"}

    # OPTIMIZATION: One shared session reuses TCP across all requests
    session = requests.Session()

    try:
        credentials = core.get_secret("wd-tool-secrets")
        quasarbaseurl = credentials.get("quasar_baseurl")
        token_response = session.post(
            quasarbaseurl + "/atr-gateway/identity-management/api/v1/auth/short-token?useDeflate=true",
            headers={"Content-Type": "application/json"},
            json={
                "username": credentials.get("quasar_username"),
                "password": credentials.get("quasar_password")
            },
            timeout=30
        )
        token_response.raise_for_status()
        token = token_response.json().get("token")
        if not token:
            return {"error": "Failed to generate Quasar token"}
    except Exception as e:
        return {"error": "Quasar token generation failed: " + str(e)}

    quasar_headers = {
        "accept": "application/json",
        "content-type": "application/json",
        "apiToken": token
    }
    search_url = quasarbaseurl + "/api/v2/acnopenai/searchvectors"
    all_results = []

    for bp in businessprocess_list:
        try:
            # OPTIMIZATION: dict() shallow copy instead of copy.deepcopy
            dynamic_payload = dict(base_payload)
            dynamic_payload["query"] = (
                "@content:Scenario Name*" + bp + "* "
                "AND @metadata:HCM_Test_Scenario_Library_Consolidated.xlsx"
            )
            response = session.post(search_url, headers=quasar_headers, json=dynamic_payload, timeout=60)
            if response.status_code == 200:
                all_results.append({"businessprocess": bp, "status_code": 200, "response": response.json()})
            else:
                all_results.append({"businessprocess": bp, "status_code": response.status_code, "error": response.text})
        except Exception as e:
            all_results.append({"businessprocess": bp, "error": str(e)})

    # ---- Part 2 ----
    filtered_by_bp = {}
    for result in all_results:
        bp_name = result.get("businessprocess", "")
        response_data = result.get("response", [])
        if isinstance(response_data, dict):
            response_items = response_data.get("items", [])
        elif isinstance(response_data, list):
            response_items = response_data
        else:
            response_items = []

        matched_scenarios = []
        for scenario_item in response_items:
            if isinstance(scenario_item, dict):
                scenario = scenario_item
            elif isinstance(scenario_item, str):
                scenario = _parse_scenario_string(scenario_item)
            else:
                continue
            workday_bp    = scenario.get("Workday BP", "")
            scenario_name = scenario.get("Scenario Name", "")
            if (bp_name.lower() in workday_bp.lower() or
                    bp_name.lower() in scenario_name.lower()):
                matched_scenarios.append(scenario)
        filtered_by_bp[bp_name] = matched_scenarios

    # ---- Claude credentials — updated to match working tool pattern ----
    try:
        claude_creds = core.get_secret("SCA_WA_Claude_Opus_4_6")
    except Exception as e:
        return {"error": "Failed to retrieve Claude credentials: " + str(e)}

    # =====================================================
    # CHUNK_SIZE=40 + max_tokens=16000:
    #
    # 40 scenarios x ~500 chars = ~5,000 tokens input
    # Claude input limit is ~190,000 tokens — easily fits
    # Before: 4 chunks x 75s = ~5 mins
    # After : 1 chunk  x 75s = ~1.5 mins
    # =====================================================
    CHUNK_SIZE = 40
    combined_df_list   = []
    processing_summary = []

    for bp_name, scenarios in filtered_by_bp.items():
        if not scenarios:
            processing_summary.append({
                "bp_name": bp_name,
                "status": "No matching scenarios after filter",
                "scenarios_found": 0
            })
            continue

        words   = [w for w in bp_name.split() if w]
        acronym = words[0][:3].upper() if len(words) == 1 else "".join([w[0].upper() for w in words])
        chunks = [scenarios[i:i + CHUNK_SIZE] for i in range(0, len(scenarios), CHUNK_SIZE)]
        bp_df_list   = []
        chunk_errors = []

        for chunk_idx, chunk in enumerate(chunks, start=1):
            try:
                start_idx       = (chunk_idx - 1) * CHUNK_SIZE + 1
                scenario_text   = _build_scenario_text(chunk, start_idx)
                markdown_output = _call_claude(session, claude_creds, bp_name, scenario_text)
                if not markdown_output:
                    chunk_errors.append("Chunk " + str(chunk_idx) + ": Claude returned empty response")
                    continue
                df = _parse_markdown_to_df(markdown_output)
                if df is None:
                    chunk_errors.append("Chunk " + str(chunk_idx) + ": No valid Markdown table in response")
                    continue
                bp_df_list.append(df)
            except Exception as e:
                chunk_errors.append("Chunk " + str(chunk_idx) + ": " + str(e))

    # ---- Part 3 ----
        if not bp_df_list:
            processing_summary.append({
                "bp_name": bp_name,
                "status": "All chunks failed",
                "scenarios_found": len(scenarios),
                "chunk_errors": chunk_errors
            })
            continue

        bp_combined_df = pandas.concat(bp_df_list, ignore_index=True)
        bp_combined_df.insert(0, "Business Process Name", bp_name)
        combined_df_list.append(bp_combined_df)
        processing_summary.append({
            "bp_name": bp_name,
            "status": "Success" if not chunk_errors else "Partial Success",
            "scenarios_found": len(scenarios),
            "chunks_total": len(chunks),
            "chunks_succeeded": len(bp_df_list),
            "test_cases_generated": len(bp_combined_df),
            "chunk_errors": chunk_errors if chunk_errors else []
        })

    if not combined_df_list:
        return {
            "error": "No Business Processes successfully generated test cases",
            "summary": processing_summary
        }

    final_df = pandas.concat(combined_df_list, ignore_index=True)
    safe_filename       = re.sub(r'[^A-Za-z0-9_\-]', '_', fileinitialname or "output")
    safe_conversationid = re.sub(r'[^A-Za-z0-9_\-]', '_', conversationid or "")
    timestamp_str       = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
    final_file_name     = safe_filename + "_" + timestamp_str + "_" + safe_conversationid + ".csv"

    csv_buffer = io.BytesIO()
    final_df.to_csv(csv_buffer, index=False, encoding="utf-8")
    csv_buffer.seek(0)
    core.write_artifact("artifacts/" + final_file_name, csv_buffer.read())
    download_url = core.generate_presigned_url(final_file_name)

    return {
        "file_name": final_file_name,
        "total_bps_processed": len(businessprocess_list),
        "successful_bps": len(combined_df_list),
        "download_url": download_url,
        "summary": processing_summary
    }


