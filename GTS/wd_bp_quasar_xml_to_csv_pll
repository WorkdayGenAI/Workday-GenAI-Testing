def _clean_text(text: str) -> str:
    """Remove encoding artifacts and HTML tags from Claude response."""
    if not text:
        return text
    replacements = {
        'â€"':    '—',
        'â€™':    "'",
        'â€œ':    '"',
        'â€\x9d': '"',
        'â€¦':    '...',
        'â€¢':    '-',
        'Â ':     ' ',
        'â€˜':    "'",
        '&amp;':  '&',
        '&lt;':   '<',
        '&gt;':   '>',
        '&nbsp;': ' ',
    }
    for bad, good in replacements.items():
        text = text.replace(bad, good)
    text = re.sub(r'<[^>]+>', ' ', text)
    text = re.sub(r' {2,}', ' ', text)
    return text.strip()


def _sanitise_header(header_text: str) -> str:
    lines     = header_text.splitlines()
    sanitised = [
        line for line in lines
        if not re.match(r'\s*Business Process\s*:', line, re.IGNORECASE)
    ]
    return "\n".join(sanitised).strip()


def _split_into_chunks(full_file_text: str) -> list:
    """
    Splits the S3 file into anonymous chunks.
    File structure:
        ={80}
        Business Process: Hire
        Reference ID: Hire_Default_Definition
        ={80}
        | wd:Order | wd:Step ...   <- table rows
        ={80}                      <- next BP or EOF
    """
    section_separator = re.compile(r'={40,}')
    parts             = [p.strip() for p in section_separator.split(full_file_text)]

    print("[DEBUG] Total parts after split: " + str(len(parts)))
    for idx, p in enumerate(parts):
        print("[DEBUG] parts[" + str(idx) + "] preview: " + repr(p[:120]))

    chunks = []
    i      = 0
    while i < len(parts):
        part = parts[i]
        if re.search(r'Business Process:', part, re.IGNORECASE):
            content_part = parts[i + 1] if (i + 1) < len(parts) else ""
            if content_part and content_part.startswith("|"):
                header_sanitised = _sanitise_header(part)
                full_chunk       = header_sanitised + "\n\n" + content_part
                chunk_id         = "CHUNK-" + uuid.uuid4().hex[:6].upper()
                chunks.append({"chunk_id": chunk_id, "content": full_chunk})
                print("[DEBUG] Created " + chunk_id + " from parts[" + str(i) + "] + parts[" + str(i + 1) + "]")
                i += 2
                continue
            elif (i + 2) < len(parts) and parts[i + 2].startswith("|"):
                content_part     = parts[i + 2]
                header_sanitised = _sanitise_header(part)
                full_chunk       = header_sanitised + "\n\n" + content_part
                chunk_id         = "CHUNK-" + uuid.uuid4().hex[:6].upper()
                chunks.append({"chunk_id": chunk_id, "content": full_chunk})
                print("[DEBUG] Created " + chunk_id + " from parts[" + str(i) + "] + parts[" + str(i + 2) + "]")
                i += 3
                continue
            else:
                print("[WARNING] Header found at parts[" + str(i) + "] but no table content nearby — skipping")
        i += 1

    return chunks


def _extract_inferred_bp(markdown: str):
    lines = markdown.strip().splitlines()
    for i, line in enumerate(lines):
        match = re.match(r'^\s*INFERRED_BP\s*:\s*(.+)', line, re.IGNORECASE)
        if match:
            inferred_name  = match.group(1).strip()
            clean_markdown = "\n".join(lines[i + 1:]).strip()
            return inferred_name, clean_markdown
    print("[WARNING] INFERRED_BP line not found in Claude response — using 'Unknown BP'")
    return "Unknown BP", markdown.strip()


def _markdown_to_df(markdown_output: str):
    lines       = [line.strip() for line in markdown_output.splitlines() if line.strip()]
    table_lines = [row for row in lines if row.startswith("|") and row.endswith("|")]

    if len(table_lines) < 2:
        return None

    sep_re  = re.compile(r'^\|[\s|:\-]+\|$')
    cleaned = [row for row in table_lines if not sep_re.match(row)]

    if len(cleaned) < 2:
        return None

    def parse_row(line: str) -> list:
        return [cell.strip() for cell in line.strip("|").split("|")]

    header = parse_row(cleaned[0])
    n_cols = len(header)
    rows   = []

    for raw_row in cleaned[1:]:
        parsed = parse_row(raw_row)
        if len(parsed) == n_cols:
            rows.append(parsed)
        elif len(parsed) > n_cols:
            merged = parsed[:n_cols - 1] + [" | ".join(parsed[n_cols - 1:])]
            rows.append(merged)

    if not rows:
        return None

    try:
        df = pandas.DataFrame(rows, columns=header)
        df = df.applymap(lambda x: _clean_text(x) if isinstance(x, str) else x)
        return df if not df.empty else None
    except Exception:
        return None


def _renumber_ids(df: pandas.DataFrame, bp_name: str) -> pandas.DataFrame:
    if "Test Case ID" not in df.columns:
        return df
    words   = re.findall(r'[A-Za-z]+', bp_name)
    acronym = "".join(w[0].upper() for w in words) if words else "BP"
    df      = df.copy()
    df["Test Case ID"] = [acronym + str(i + 1).zfill(4) for i in range(len(df))]
    return df


