    # 835-token limit
    def _get_artifact_bytes_anywhere(filename: str):
        raw_bytes = core.get_artifact(
                "uploaded_artifacts/" + filename,
                text=False
            )
        return raw_bytes
    
    
    def _safe_id(value: str) -> str:
        value = str(value).strip()
        return re.sub(r"[^A-Za-z0-9_\-]", "_", value) if value else uuid.uuid4().hex


