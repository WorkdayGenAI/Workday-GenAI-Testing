    # =====================================================
    # Claude call (single pass, with continuation if max_tokens hit)
    # =====================================================
    
    def _call_claude(credentials: dict, prompt: str, max_tokens: int) -> str:
        """
        Calls an Anthropic-compatible messages endpoint via requests.
        Supports continuation if stop_reason == 'max_tokens'.
        """
        endpoint = credentials.get("Endpoint", "").rstrip("/")
        api_key = credentials.get("api_key")
        model = credentials.get("deployment_name")
    
        if not endpoint or not api_key or not model:
            raise ValueError("Claude credentials missing Endpoint/api_key/deployment_name")
    
        url = endpoint + "/anthropic/v1/messages"
        headers = {
            "x-api-key": api_key,
            "Content-Type": "application/json",
            "anthropic-version": "2023-06-01"
        }
    
        session = requests.Session()
        messages = [{"role": "user", "content": prompt}]
        full_text = ""
    
        while True:
            payload = {
                "model": model,
                "max_tokens": max_tokens,
                "temperature": 0.2,
                "messages": messages
            }
    
            resp = session.post(url, headers=headers, json=payload, timeout=(10, 300))
            resp.raise_for_status()
            data = resp.json()
    
            chunk = "".join(item.get("text", "") for item in data.get("content", [])).strip()
            full_text += chunk
    
            if data.get("stop_reason") != "max_tokens":
                break
    
            # continuation
            messages.append({"role": "assistant", "content": chunk})
            messages.append({
                "role": "user",
                "content": "Continue from exactly where you stopped. Do not repeat content."
            })
    
        return full_text
    
    
    # =====================================================
    # Text cleanup
    # =====================================================
    
    def _clean_text(text: str) -> str:
        """
        Fix common encoding artifacts and strip HTML-like tags that show up as entities.
        """
        if not text:
            return text
    
        replacements = {
            "â€\"": "—",
            "â€™": "'",
            "â€œ": "\"",
            "â€\x9d": "\"",
            "â€¦": "...",
            "â€¢": "-",
            "Â ": " ",
            "&amp;amp;": "&amp;",
            "&amp;lt;": "&lt;",
            "&amp;gt;": "&gt;",
            "&amp;nbsp;": " "
        }
        for bad, good in replacements.items():
            text = text.replace(bad, good)
    
        # remove entity-encoded tags like &lt;div&gt;
        text = re.sub(r"&lt;[^&gt;]+&gt;", " ", text)
        text = re.sub(r"\s{2,}", " ", text)
        return text.strip()
    
    
    # =====================================================
    # Markdown table -> DataFrame
    # =====================================================
    
    def _markdown_to_df(markdown_output: str):
        """
        Parses a single markdown table into a DataFrame.
        Requires at least header row + one data row.
        """
        if not markdown_output:
            return None
    
        lines = [ln.strip() for ln in markdown_output.splitlines() if ln.strip()]
        table_lines = [ln for ln in lines if ln.startswith("|") and ln.endswith("|")]
    
        if len(table_lines) < 2:
            return None
    
        # Remove separator row like: | --- | --- |
        sep_re = re.compile(r"^\|[\s:\-|]+\|$")
        cleaned = [ln for ln in table_lines if not sep_re.match(ln)]
    
        if len(cleaned) < 2:
            return None
    
        header = _parse_md_row(cleaned[0])
        n_cols = len(header)
        rows = []
        rows.append(header)
        for raw in cleaned[1:]:
            parsed = _parse_md_row(raw)
    
            if len(parsed) == n_cols:
                rows.append(parsed)
            elif len(parsed) > n_cols:
                # merge overflow into last column
                merged = parsed[:n_cols - 1] + [" | ".join(parsed[n_cols - 1:])]
                rows.append(merged)
            else:
                # too few cols; pad
                rows.append(parsed + [""] * (n_cols - len(parsed)))
    
        try:
            df = pd.DataFrame(rows, columns=header)
            return df if not df.empty else None
        except Exception:
            return None
    
    
    def _parse_md_row(line: str):
        # split by pipe and trim
        return [cell.strip() for cell in line.strip("|").split("|")]
    
    
