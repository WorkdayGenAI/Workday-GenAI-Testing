    """
    Run Claude Code in a pseudo-terminal (PTY) and return the response.
    In headless mode it doesn't auto compact and seems to not use TODO tools,
    this is avoided by running it in a PTY.
    """
    READ_TIMEOUT_SECONDS = 60
    WAIT_TIMEOUT_SECONDS = 3600  # 6 hours
    THROTTLE_TIME_SECONDS = 10
    BUFFER_SIZE = 1024
    TERM_WIDTH = 80
    TERM_HEIGHT = 24
    CLAUDE_CODE_VERSION = "1.0.41"
    CONFIG_PATH = os.path.expanduser("~/.claude.json")
    CLAUDE_DIR = os.path.expanduser("~/.claude")
    PROJECTS_DIR = os.path.expanduser("~/.claude/projects/")
    SETTINGS_PATH = os.path.expanduser("~/.claude/settings.json")
    MASTER_FD_KEY = "master_fd"
    PROCESS_STARTED_KEY = "process_started"
    CLAUDE_INITIALISED_KEY = "claude_initialised"
    CLAUDE_RESPONSE_READY_KEY = "claude_response_ready"
    CREDENTIALS_KEY = "Bedrock Sonnet 4.5"
    LAST_MODEL_KEY = "claude_model"
    
    def get_repository_dir(conversation_id=None) -> str:

    # ---------- STEP 1: Resolve conversation_id ----------
        if not conversation_id:
            conversation_id = core.get_local_value("conversation_id")
    
        if not conversation_id:
            conversation_id = str(uuid.uuid4())
            print("Generated new conversation_id:", conversation_id)
    
        core.set_local_value("conversation_id", conversation_id)
    
        # ---------- STEP 2: Build project_dir ----------
        if "-" in conversation_id:
            last_part = conversation_id.split("-")[-1]
        else:
            last_part = conversation_id
    
        project_dir = f"./project_{last_part}"
        repository_dir = f"{project_dir}/ba_dir"
    
        os.makedirs(repository_dir, exist_ok=True)
    
        core.set_local_value("project_dir", project_dir)
        core.set_local_value("repository_dir", repository_dir)
    
        return repository_dir

    def get_event(key: str) -> threading.Event:
        event = core.get_local_value(key)
        if not event:
            event = threading.Event()
            core.set_local_value(key, event)

        return event

    claude_failure = False
    previous_response_time = 0

    repository_dir = get_repository_dir(conversation_id)
    claude_initialised = get_event(CLAUDE_INITIALISED_KEY)
    claude_response_ready = get_event(CLAUDE_RESPONSE_READY_KEY)
    credentials = core.get_secret(CREDENTIALS_KEY)
    

    def build_env() -> dict[str, str]:
        env = os.environ.copy()
        env["AWS_REGION"] = credentials.get("Region")
        env["AWS_ACCESS_KEY_ID"] = credentials.get("AWS Access Key ID")
        env["AWS_SECRET_ACCESS_KEY"] = credentials.get("AWS Secret Access Key")

        print("Environment variables set for Claude CLI")												 
        return env

    def start_process() -> None:
        if core.get_local_value(PROCESS_STARTED_KEY):
            return
        core.set_local_value(PROCESS_STARTED_KEY, True)
        

        thread = threading.Thread(target=_start_process, daemon=True)
        thread.start()

    def install_claude_code() -> None:
        try:
            process = subprocess.run(
                [
                    "npm",
                    "install",
                    f"@anthropic-ai/claude-code@{CLAUDE_CODE_VERSION}",
                ],
                check=True,
                text=True,
                capture_output=True,
                cwd=os.path.expanduser("~"),
            )
            print("Claude Code installed successfully")    
        except subprocess.CalledProcessError as e:
            print("Failed to install Claude Code")										  
            return "Failed to install Claude Code"
            raise e

    def configure_claude_code() -> None:
        os.makedirs(CLAUDE_DIR, exist_ok=True)

        config = {
            "theme": "light",
            "hasCompletedOnboarding": True,
            "bypassPermissionsModeAccepted": True,
        }
        config_str = json.dumps(config, indent=4)
        with open(CONFIG_PATH, "w") as f:
            _ = f.write(config_str)

        settings = {
            "env": {
                "CLAUDE_CODE_USE_BEDROCK": "1",
                "ANTHROPIC_MODEL": credentials.get("Model"),
                "CLAUDE_CODE_SUBAGENT_MODEL": credentials.get("Model"),
                "DISABLE_AUTOUPDATER": "1",
                "DISABLE_BUG_COMMAND": "1",
                "DISABLE_COST_WARNINGS": "1",
                "DISABLE_ERROR_REPORTING": "1",
                "DISABLE_TELEMETRY": "1",
            },
        }
        core.set_local_value(LAST_MODEL_KEY, credentials["Model"])
        settings_str = json.dumps(settings, indent=4)
        with open(SETTINGS_PATH, "w") as f:
            _ = f.write(settings_str)

    def _start_process() -> None:
        print("Starting Claude CLI process...")									   
        install_claude_code()
        configure_claude_code()

        env = build_env()
        master_fd, slave_fd = pty.openpty()
        core.set_local_value(MASTER_FD_KEY, master_fd)

        # Set the terminal size for the PTY
        winsize = struct.pack("HHHH", TERM_HEIGHT, TERM_WIDTH, 0, 0)
        fcntl.ioctl(slave_fd, termios.TIOCSWINSZ, winsize)

        cmd = ["npx", "claude", "--dangerously-skip-permissions"]

        process = subprocess.Popen(
            cmd,
            stdin=slave_fd,
            stdout=slave_fd,
            stderr=slave_fd,
            close_fds=True,
            env=env,
            cwd=repository_dir,
        )


        try:
            is_stream_dirty = False
            screen = pyte.Screen(TERM_WIDTH, TERM_HEIGHT)
            stream = pyte.ByteStream(screen)

            while True:
                rlist, _, _ = select.select([master_fd], [], [], READ_TIMEOUT_SECONDS)
                if master_fd in rlist:
                    try:
                        data = os.read(master_fd, BUFFER_SIZE)
                        if not data:
                            break

                        erase_in_line_index = data.find(b"\x1b[2K")
                        if erase_in_line_index >= 0:
                            before = data[:erase_in_line_index]
                            after = data[erase_in_line_index:]
                        else:
                            before = data
                            after = None

                        stream.feed(before)
                        is_stream_dirty = True

                        # Only process if the screen is about to be cleared
                        # as then we know that the full response is ready
                        if after:
                            process_screen(screen, allow_final=False)
                            stream.feed(after)
                    except OSError:
                        break
                # Timeout reached, new data hasn't arrived
                elif is_stream_dirty:
                    is_stream_dirty = False
                    process_screen(screen, allow_final=True)

                if process.poll() is not None:
                    break
        finally:
            
            os.close(master_fd)
            os.close(slave_fd)

        nonlocal claude_failure
        claude_failure = True
        

    def process_screen(screen, allow_final=True) -> None:
        response_lines = screen.display
        joined_response = "\n".join(response_lines).strip()

        if joined_response.strip():
            # Must check in joined_response and not cleaned_response
            if "interrupt" in joined_response.lower():
                on_response(joined_response)
            elif allow_final:
                on_final_response(joined_response)
            else:
                on_response(joined_response)

    def on_response(response: str):
        if not claude_initialised.is_set():
            print("Received message before initialization")											   
            return

        now = time.time()
        nonlocal previous_response_time
        if now - previous_response_time < THROTTLE_TIME_SECONDS:
            return

        previous_response_time = now
        on_throttled_response(response)

    def on_throttled_response(response: str):
        # print("Throttled response received",response)
        return

    def on_final_response(response: str):
        if not claude_initialised.is_set():
            claude_initialised.set()
            return

        # Set the previous response to the final response as when the next message is
        # sent, first there is a partial response matching the final response of the
        # previous message.
        nonlocal previous_response_time
        previous_response_time = 0

        print("Final response received", response)								
        claude_response_ready.set()

    def send_input(text: str) -> None:
        print("Sending input to Claude Code:")
        master_fd = core.get_local_value(MASTER_FD_KEY)

        time.sleep(1)
        _ = os.write(master_fd, text.encode())
        # Need to wait to ensure Claude doesn't think newline is part of pasted content
        time.sleep(1)
        # Send Enter key
        _ = os.write(master_fd, b"\r")
        # In case enter got missed, send it again
        time.sleep(1)
        _ = os.write(master_fd, b"\r")

        

    def get_last_modified_file(directory):
        last_modified_file = None
        last_modified_time = 0
        print("Searching for last modified file in directory:", directory)

        # Walk through all files in the directory and its subdirectories
        for root, dirs, files in os.walk(directory):
            for file in files:
                file_path = os.path.join(root, file)
                # Get the last modified time of the file
                file_modified_time = os.path.getmtime(file_path)

                # If this file is more recently modified, update the result
                if file_modified_time > last_modified_time:
                    last_modified_time = file_modified_time
                    last_modified_file = file_path

        return last_modified_file

    def read_response(transcript_path: str) -> str | None:
        full_response_parts = []
        try:
            with open(transcript_path, "r", encoding="utf-8") as f:
                lines = f.readlines()
    
            # Read from bottom → newest messages first
            for raw_line in reversed(lines):
                try:
                    line = json.loads(raw_line)
    
                    if (
                        line.get("type") == "assistant"
                        and line.get("message", {}).get("type") == "message"
                    ):
                        content_blocks = line["message"].get("content", [])
    
                        for block in content_blocks:
                            # Claude 4.x splits large output into multiple text blocks
                            if block.get("type") == "text":
                                text = block.get("text", "")
                                if text.strip():
                                    full_response_parts.append(text)
    
                        # Stop once we captured latest assistant message
                        if full_response_parts:
                            break
    
                except Exception:
                    continue
    
            if not full_response_parts:
                return None
    
            # Join all pieces into final markdown
            full_response_parts.reverse()
            final_response = "\n".join(full_response_parts)
    
            print("Claude Code FULL response extracted")
            return final_response
    
        except Exception as e:
            print("Failed to read transcript:", e)
            return None

    def _clean_text(text: str) -> str:
        """Remove encoding artifacts and HTML tags from Claude response."""
        print("clean response")
        if not text:
            return text
        replacements = {
            'â€"':    '—',
            'â€”':    '—',
            'â€™':    "'",
            'â€œ':    '"',
            'â€\x9d': '"',
            'â€¦':    '...',
            'â€¢':    '-',
            'Â ':     ' ',
            'â€˜':    "'",
            '&amp;':  '&',
            '&lt;':   '<',
            '&gt;':   '>',
            '&nbsp;': ' ',
        }
        for bad, good in replacements.items():
            text = text.replace(bad, good)
        text = re.sub(r'<[^>]+>', ' ', text)
        text = re.sub(r' {2,}', ' ', text)
        return text.strip()

    def send_input_and_wait_for_completion(text: str) -> None:
        claude_response_ready.clear()
        send_input(text)

        # Block until the response is ready
        is_ready = claude_response_ready.wait(timeout=WAIT_TIMEOUT_SECONDS)
        if not is_ready:
            raise TimeoutError("Claude Code did not respond in time")
    
    try:
        if not prompt:
            return "No prompt provided"
        # print("Prompt:" + prompt)

        start_process()

        # Block until the process is ready
        is_initialised = claude_initialised.wait(timeout=WAIT_TIMEOUT_SECONDS)
        if not is_initialised:
            raise TimeoutError("Claude Code did not initialize in time")

        # Switch model in case Claude Code was started with a different model
        last_model = core.get_local_value(LAST_MODEL_KEY)
        if last_model != credentials["Model"]:
            send_input_and_wait_for_completion("/model " + credentials["Model"])
            core.set_local_value(LAST_MODEL_KEY, credentials["Model"])
            
        send_input_and_wait_for_completion(prompt)

        previous_session_file = get_last_modified_file(PROJECTS_DIR)
        print("Last session file:", previous_session_file)												  
        response = read_response(previous_session_file)
        response = _clean_text(response)
        print("reponse: "+ response)
    except Exception as e:
        traceback.print_exc()
        return f"An error occurred while running Claude Code - {e}"

    try:
