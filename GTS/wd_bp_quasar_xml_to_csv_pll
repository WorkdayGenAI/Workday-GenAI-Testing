def wd_bp_quasar_xml_to_csv_pll(conversationid: typing.Annotated[str, "Conversation identifier"] = None):


    """
    Reads S3 file named XML_Details_{conversationid}.txt via core.get_artifact,
    splits it into anonymous BP chunks, sends each chunk to Claude in PARALLEL,
    Claude infers the BP name from step data, results combined into one CSV.

    Parallel optimisation (no new top-level imports):
    - concurrent.futures imported locally at point of use
    - Each thread gets its own requests.Session (thread-safe)
    - Chunk order preserved via indexed result slots
    - Wall-clock time ≈ one Claude call duration regardless of chunk count
    """

    # ---- 1. Validate inputs ----
    if not conversationid or not conversationid.strip():
        return {"error": "Missing required conversationid"}

    safe_convid = re.sub(r'[^A-Za-z0-9_\-]', '_', conversationid.strip())

    # ---- 2. Fetch file using core.get_artifact (artifacts/ prefix required) ----
    candidates = [
        "artifacts/XML_Details_" + safe_convid + ".txt",
        "artifacts/xml_details_" + safe_convid + ".txt"
    ]
    full_file_text  = None
    input_file_name = None

    for candidate in candidates:
        print("[DEBUG] Trying core.get_artifact: " + candidate)
        try:
            raw = core.get_artifact(candidate, text=True)
            if not raw:
                print("[DEBUG] '" + candidate + "' returned empty — skipping")
                continue
            body = str(raw).strip()
            if body.lower().startswith("<!doctype") or body.lower().startswith("<html"):
                print("[DEBUG] '" + candidate + "' returned HTML page — skipping")
                continue
            full_file_text  = body
            input_file_name = candidate
            print("[DEBUG] Successfully fetched: " + candidate + " (" + str(len(full_file_text)) + " chars)")
            break
        except Exception as e:
            print("[DEBUG] core.get_artifact failed for '" + candidate + "': " + str(e))
            continue

    if not full_file_text or not input_file_name:
        return {
            "error": (
                "Could not fetch file for conversationid='" + conversationid + "'. "
                "Tried: " + str(candidates) + ". "
                "Ensure the extraction tool was run first with the same conversationid."
            )
        }

    print("[DEBUG] Raw file content preview:\n" + full_file_text[:500])

    # ---- 3. Split file into anonymous chunks ----
    chunks = _split_into_chunks(full_file_text)
    if not chunks:
        return {"error": "No BP sections found in file: " + input_file_name}

    print("[DEBUG] Total chunks found: " + str(len(chunks)))
    for c in chunks:
        print("[DEBUG]   chunk_id=" + c['chunk_id'] + "  chars=" + str(len(c['content'])))

    # ---- 4. Claude credentials ----
    try:
        credentials = core.get_secret("SCA_WA_Claude_Opus_4_6")
    except Exception as e:
        return {"error": "Failed to retrieve Claude credentials: " + str(e)}

    max_tokens = 8000

    # =====================================================
    # PARALLEL CLAUDE CALLS
    #
    # MAX_WORKERS=8:
    #   All chunks fire simultaneously (I/O bound).
    #   Wall-clock time ≈ one Claude call duration (~75–120s)
    #   regardless of total chunk count.
    #   Tune down if you hit API rate limits.
    #
    # concurrent.futures imported locally — avoids top-level
    # import restriction of the tool framework.
    # =====================================================
    MAX_WORKERS = 8

    # ── Worker — each thread gets its own Session (thread-safe) ──────────────
    def _process_chunk(args):
        idx, chunk = args
        chunk_id = chunk["chunk_id"]
        content  = chunk["content"]
        print("[DEBUG] Processing chunk_id=" + chunk_id)
        print("[DEBUG] Content preview:\n" + content[:400] + "\n" + "─" * 60)

        # New session per thread — avoids shared-state race conditions
        thread_session = requests.Session()
        try:
            prompt   = _build_claude_prompt(chunk_id, content)
            markdown = _call_claude_with_session(thread_session, credentials, prompt, max_tokens)

            if not markdown:
                msg = "Empty Claude response for chunk_id=" + chunk_id
                print("[WARNING] " + msg)
                return idx, None, None, {"chunk_id": chunk_id, "status": "Failed", "reason": msg}

            print("[DEBUG] chunk_id=" + chunk_id + " Claude response preview:\n" + markdown[:800] + "\n" + "─" * 60)

            markdown = _clean_text(markdown)
            inferred_bp, clean_markdown = _extract_inferred_bp(markdown)
            print("[DEBUG] chunk_id=" + chunk_id + " inferred BP='" + inferred_bp + "'")

            df = _markdown_to_df(clean_markdown)
            if df is None:
                print("[DEBUG] Full failed Claude response for chunk_id=" + chunk_id + ":\n" + markdown + "\n" + "─" * 60)
                msg = "No valid markdown table returned by Claude for chunk_id=" + chunk_id
                return idx, None, inferred_bp, {
                    "chunk_id":    chunk_id,
                    "inferred_bp": inferred_bp,
                    "status":      "Failed",
                    "reason":      msg
                }

            df = _renumber_ids(df, inferred_bp)
            df.insert(0, "Business Process Name", inferred_bp)
            return idx, df, inferred_bp, {
                "chunk_id":       chunk_id,
                "inferred_bp":    inferred_bp,
                "status":         "Success",
                "rows_generated": len(df)
            }

        except requests.exceptions.Timeout:
            msg = "Claude call timed out for chunk_id=" + chunk_id
            print("[WARNING] " + msg)
            return idx, None, None, {"chunk_id": chunk_id, "status": "Failed", "reason": msg}
        except Exception as e:
            msg = "Error processing chunk_id=" + chunk_id + ": " + str(e)
            print("[ERROR] " + msg)
            return idx, None, None, {"chunk_id": chunk_id, "status": "Failed", "reason": msg}

    # ── Dispatch all chunks in parallel ──────────────────────────────────────
    # Pre-allocate ordered result slots to preserve chunk order in final CSV
    ordered_results    = [None] * len(chunks)   # df per slot
    processing_summary = [None] * len(chunks)   # summary per slot

    import concurrent.futures  # local import — avoids top-level restriction

    tasks = [(idx, chunk) for idx, chunk in enumerate(chunks)]

    with concurrent.futures.ThreadPoolExecutor(max_workers=MAX_WORKERS) as executor:
        futures = {executor.submit(_process_chunk, task): task for task in tasks}
        for future in concurrent.futures.as_completed(futures):
            idx, df, inferred_bp, summary = future.result()
            ordered_results[idx]    = df       # None if failed — filtered below
            processing_summary[idx] = summary

    # ── Assemble final dataframe in original chunk order ─────────────────────
    combined_df_list = [df for df in ordered_results if df is not None]
    processing_summary = [s for s in processing_summary if s is not None]

    # ---- 5. Generate combined output CSV ----
    if not combined_df_list:
        return {
            "error":   "No chunks successfully processed",
            "summary": processing_summary
        }

    final_df        = pandas.concat(combined_df_list, ignore_index=True)
    final_file_name = "TestCaseGenerated_" + safe_convid + ".csv"

    csv_buffer = io.BytesIO()
    final_df.to_csv(csv_buffer, index=False, encoding="utf-8-sig")
    csv_buffer.seek(0)
    core.write_artifact("artifacts/" + final_file_name, csv_buffer.getvalue())
    output_url = core.generate_presigned_url(final_file_name)

    successful = [s for s in processing_summary if s["status"] == "Success"]
    failed     = [s for s in processing_summary if s["status"] == "Failed"]

    return {
        "file_name":          final_file_name,
        "source_steps_file":  input_file_name,
        "total_chunks_found": len(chunks),
        "successful_chunks":  len(successful),
        "failed_chunks":      len(failed),
        "total_rows":         len(final_df),
        "download_url":       output_url,
        "summary":            processing_summary
    }


# =====================================================
# CLAUDE CALL — session-aware version for parallel use
# (original _call_claude signature kept below for
#  any other callers; this variant accepts a session)
# =====================================================

def _call_claude_with_session(session: requests.Session, credentials: dict, prompt: str, max_tokens: int) -> str:
    base_url = credentials.get("Endpoint", "").rstrip("/") + "/anthropic/v1/messages"
    api_key  = credentials.get("api_key")
    model    = credentials.get("deployment_name")

    headers = {
        "x-api-key":         api_key,
        "Content-Type":      "application/json",
        "anthropic-version": "2023-06-01"
    }

    messages  = [{"role": "user", "content": prompt}]
    full_text = ""

    while True:
        payload = {
            "model":       model,
            "max_tokens":  max_tokens,
            "temperature": 0.2,
            "messages":    messages
        }
        resp = session.post(base_url, headers=headers, json=payload, timeout=(10, 300))
        resp.raise_for_status()
        data  = resp.json()
        chunk = "".join(item.get("text", "") for item in data.get("content", [])).strip()
        full_text += chunk

        if data.get("stop_reason") != "max_tokens":
            break

        messages.append({"role": "assistant", "content": chunk})
        messages.append({
            "role":    "user",
            "content": "Continue from exactly where you stopped. Do not repeat content."
        })

    return full_text


def _call_claude(credentials: dict, prompt: str, max_tokens: int) -> str:
    """Original signature — creates its own session. Kept for compatibility."""
    return _call_claude_with_session(requests.Session(), credentials, prompt, max_tokens)


