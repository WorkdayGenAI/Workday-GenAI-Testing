# HELPER FUNCTIONS
# =====================================================
def _parse_bp_input(raw_input):
    try:
        parsed = json.loads(raw_input)
    except Exception:
        parsed = raw_input
    if isinstance(parsed, list):
        return parsed
    if isinstance(parsed, dict) and "BusinessProcessName" in parsed:
        return parsed.get("BusinessProcessName", [])
    if isinstance(parsed, str):
        try:
            inner = json.loads(parsed)
            if isinstance(inner, list):
                return inner
        except Exception:
            pass
        if "," in parsed:
            return [x.strip() for x in parsed.split(",")]
        return [parsed.strip()]
    return []


def _parse_scenario_string(scenario_str):
    known_keys = [
        "Workstream", "Workday BP", "Scenario ID", "Scenario Name",
        "Test Scenario Description", "Expected Result", "Initiator"
    ]
    key_positions = []
    for key in known_keys:
        pattern = re.compile(r'(?:^|,\s*)' + re.escape(key) + r'\s*:\s*', re.IGNORECASE)
        match = pattern.search(scenario_str)
        if match:
            key_positions.append((match.start(), match.end(), key))
    key_positions.sort(key=lambda x: x[0])
    scenario = {}
    for i, (start, value_start, key) in enumerate(key_positions):
        value_end = key_positions[i + 1][0] if i + 1 < len(key_positions) else len(scenario_str)
        value = scenario_str[value_start:value_end].strip().rstrip(",").strip()
        scenario[key] = value
    return scenario


def _build_scenario_text(scenarios_slice, start_idx):
    text = ""
    for idx, s in enumerate(scenarios_slice, start=start_idx):
        text += (
            "\nScenario " + str(idx) + ":\n"
            "  Scenario ID: " + str(s.get("Scenario ID", "")) + "\n"
            "  Scenario Name: " + str(s.get("Scenario Name", "")) + "\n"
            "  Workday BP: " + str(s.get("Workday BP", "")) + "\n"
            "  Workstream: " + str(s.get("Workstream", "")) + "\n"
            "  Test Scenario Description: " + str(s.get("Test Scenario Description", "")) + "\n"
            "  Expected Result: " + str(s.get("Expected Result", "")) + "\n"
            "  Initiator: " + str(s.get("Initiator", "")) + "\n"
        )
    return text


def _call_claude(session, claude_creds, bp_name, scenario_text):
    # ---- Updated to match working tool pattern ----
    base_url = claude_creds.get("Endpoint", "").rstrip("/") + "/anthropic/v1/messages"
    api_key  = claude_creds.get("api_key")
    model    = claude_creds.get("deployment_name")

    headers = {
        "x-api-key":         api_key,
        "Content-Type":      "application/json",
        "anthropic-version": "2023-06-01"
    }

    claude_prompt = (
        "##Goal: Generate Workday Test Cases in Markdown table format.\n\n"
        "##Instructions:\n"
        "Do not include any additional commentary, special characters, or formatting beyond what is specified in the output format.\n\n"
        "##Rules:\n"
        "Use the following fields from the SCENARIO INPUT as the basis for test case creation:\n"
        "- Scenario Name\n- Workday BP\n- Test Scenario Description\n- Expected Result\n- Initiator\n\n"
        "Each test case should reflect the logic, conditions, roles, and validations defined in these fields.\n\n"
        "- 'Scenario ID' should be value of Scenario ID from the scenario input.\n"
        "- 'Test Scenario' should be Test Scenario description from the scenario input.\n\n"
        "##Test Data / Inputs:\n"
        "Review the scenario details and identify the data required to execute the test case "
        "(e.g., Employee Name, Position, Location, Effective Date).\n\n"
        "##Test Case Description:\n"
        "Provide a concise summary relevant to the overall scenario described in the test case.\n\n"
        "##Test Steps:\n"
        "Provide detailed, step-by-step instructions from initiation to completion in a single paragraph format. "
        "Each step must be explicitly numbered (1, 2, 3, etc.). "
        "All steps must be written continuously in one paragraph, separated by full stop.\n\n"
        "##Expected Result:\n"
        "Clearly state the expected outcome for each numbered step. "
        "Written continuously in a single paragraph, separated by full stop.\n\n"
        "##Security Role:\n"
        "Derive the Security Role from the 'Initiator' field of each scenario.\n\n"
        "##Output columns (Markdown table, no extra text outside the table):\n"
        "| Test Scenario | Security Role | Test Data/Inputs | Scenario ID | Test scenario Description | Test Steps | Expected Result |\n\n"
        "SCENARIO INPUT for Business Process: " + bp_name + "\n" + scenario_text
    )

    messages  = [{"role": "user", "content": claude_prompt}]
    full_text = ""

    while True:
        claude_payload = {
            "model":       model,
            "max_tokens":  16000,
            "temperature": 0.2,
            "messages":    messages
        }
        response = session.post(base_url, headers=headers, json=claude_payload, timeout=(10, 300))
        response.raise_for_status()
        data  = response.json()
        chunk = "".join([item.get("text", "") for item in data.get("content", [])]).strip()
        full_text += chunk

        # Stop if Claude finished naturally
        if data.get("stop_reason") != "max_tokens":
            break

        # Continue if response was cut off at max_tokens
        messages.append({"role": "assistant", "content": chunk})
        messages.append({
            "role": "user",
            "content": "Continue from exactly where you stopped. Do not repeat content."
        })

    return full_text


def _parse_markdown_to_df(markdown_output):
    lines = [line.strip() for line in markdown_output.splitlines() if line.strip()]
    table_lines = [line for line in lines if line.startswith("|")]

    if len(table_lines) < 2:
        return None

    cleaned_lines = [
        line for line in table_lines
        if not re.match(r'^\|\s*[-:]+[\s|:|-]*$', line)
    ]

    csv_text = "\n".join([line.strip("|") for line in cleaned_lines])

    try:
        df = pandas.read_csv(io.StringIO(csv_text), sep="|", engine="python")
        df.columns = [col.strip() for col in df.columns]
        df = df.applymap(lambda x: x.strip() if isinstance(x, str) else x)
        return df
    except Exception:
        return None
